<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<TabPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kolappam.FXMLDocumentController">
   <tabs>
      <Tab closable="false" text="Main Screen">
         <content>
            <VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="1000.0" spacing="50.0">
               <children>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <Label text="BILLING">
                           <font>
                              <Font size="48.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" layoutX="10.0" layoutY="10.0" prefHeight="100.0" prefWidth="200.0" spacing="20.0">
                     <children>
                        <VBox alignment="TOP_RIGHT" prefHeight="200.0" prefWidth="100.0" spacing="30.0">
                           <children>
                              <Label text="Id:" />
                              <Label layoutX="10.0" layoutY="10.0" text="Name:" />
                              <Label layoutX="10.0" layoutY="28.0" text="Address:" />
                              <Label layoutX="10.0" layoutY="46.0" text="Contact No:">
                                 <VBox.margin>
                                    <Insets top="50.0" />
                                 </VBox.margin>
                              </Label>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" layoutX="10.0" layoutY="10.0" prefHeight="50.0" prefWidth="250.0" spacing="20.0">
                           <children>
                              <TextField fx:id="txtId" promptText="Custtomer Id" />
                              <TextField fx:id="txtName" layoutX="10.0" layoutY="10.0" promptText="Customer Name" />
                              <VBox>
                                 <children>
                                    <HBox>
                                       <children>
                                          <TextField fx:id="txtDoorNo" maxWidth="50.0" promptText="Door" />
                                          <TextField fx:id="txtStreet" prefWidth="200.0" promptText="street name" />
                                       </children>
                                    </HBox>
                                    <TextField fx:id="txtArea" promptText="Address" />
                                    <TextField fx:id="txtCity" layoutX="10.0" layoutY="36.0" promptText="city" />
                                 </children>
                              </VBox>
                              <TextField fx:id="txtMobileNumber" layoutX="10.0" layoutY="148.0" promptText="Mobile Number" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" layoutX="10.0" layoutY="110.0" prefHeight="100.0" prefWidth="200.0" spacing="20.0">
                     <children>
                        <Button fx:id="btSaveRecord" mnemonicParsing="false" onAction="#btSaveClicked" onMouseEntered="#buttonMouseEntered" onMouseExited="#buttonMouseExited" text="Save Record" />
                        <Button layoutX="10.0" layoutY="10.0" mnemonicParsing="false" text="Update Record" />
                        <Button layoutX="512.0" layoutY="47.0" mnemonicParsing="false" text="Cancel" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </Tab>
      <Tab closable="false" text="All Details">
         <content>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <TableView fx:id="tbDetails" maxHeight="200.0" prefHeight="200.0" prefWidth="600.0">
                    <columns>
                      <TableColumn prefWidth="75.0" text="id">
                            <cellValueFactory>
                                <javafx.scene.control.cell.PropertyValueFactory property="id" /> 
                            </cellValueFactory>
                      </TableColumn>
                      <TableColumn prefWidth="160.0" text="name">
                          <cellValueFactory>
                                <javafx.scene.control.cell.PropertyValueFactory property="name" /> 
                            </cellValueFactory>
                      </TableColumn>
                        <TableColumn prefWidth="250.0" text="Address">
                            <cellValueFactory>
                                <javafx.scene.control.cell.PropertyValueFactory property="address" /> 
                            </cellValueFactory>
                      </TableColumn>
                        <TableColumn prefWidth="120.0" text="Contact Number">
                            <cellValueFactory>
                                <javafx.scene.control.cell.PropertyValueFactory property="contactNumber" /> 
                            </cellValueFactory>
                      </TableColumn>
                    </columns>
                  </TableView>
               </children>
            </HBox>
         </content></Tab>
   </tabs>
</TabPane>
